{
  "name": "slg-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:standalone": "next build && rm -rf .next/standalone/.next/static .next/standalone/public && cp -R .next/static .next/standalone/.next/static && cp -R public .next/standalone/public",
    "start:standalone": "node .next/standalone/server.js",
    "check:frontmatter": "node scripts/content/check-frontmatter.ts",
    "check:pairs": "node scripts/content/check-pairs.ts",
    "check:nomenclature": "node scripts/content/check-nomenclature.ts",
    "check:pending": "node scripts/content/check-pending.ts",
    "check:content": "npm run check:types && npm run check:frontmatter && npm run check:pairs && npm run check:nomenclature && npm run check:pending",
    "check:gates": "node scripts/content/verify-gates.ts",
    "check:types": "tsc --noEmit -p scripts/tsconfig.json",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node scripts/db/seed.ts",
    "test:isolation": "node scripts/db/test-isolation.ts",
    "test:contracts": "node scripts/db/test-contratos.ts",
    "test:nocompile": "node scripts/db/test-no-compila.ts",
    "test:auth": "node scripts/db/test-auth.ts",
    "test:invitations": "node scripts/db/test-invitations.ts",
    "test:anti-abuse": "node scripts/db/test-anti-abuse.ts",
    "check:auth-encapsulado": "node scripts/db/check-auth-encapsulado.ts",
    "check:email-encapsulado": "node scripts/email/check-email-encapsulado.ts",
    "test:email": "node scripts/email/test-email.ts",
    "check:files-encapsulado": "node scripts/files/check-files-encapsulado.ts",
    "check:no-gated-files": "node scripts/files/check-no-gated-files.ts",
    "test:files": "node scripts/files/test-files.ts",
    "test:db": "npm run test:isolation && npm run test:contracts && npm run test:nocompile && npm run test:auth",
    "db:setup-role": "node scripts/db/setup-app-role.ts",
    "backup:run": "node scripts/backups/run-backup.ts",
    "backup:pre-migration": "node scripts/backups/run-backup.ts --pre-migration",
    "backup:prune": "node scripts/backups/prune-backups.ts",
    "backup:restore": "node scripts/backups/restore-backup.ts",
    "check:backup-encapsulado": "node scripts/backups/check-backup-encapsulado.ts",
    "test:backups": "node scripts/backups/test-backups.ts",
    "db:deploy": "npm run backup:pre-migration && npm run db:migrate && npm run db:setup-role",
    "check:secrets": "node scripts/ci/check-secrets.ts",
    "check:lighthouse": "node scripts/ci/check-lighthouse.ts",
    "test:ci-gates": "node scripts/ci/test-secret-scanner.ts && node scripts/ci/test-lighthouse-gate.ts && node scripts/content/verify-gates.ts",
    "verify": "npm run check:secrets && npm run lint && npx tsc --noEmit && npx tsc --noEmit -p scripts/tsconfig.json && npm run check:auth-encapsulado && npm run check:email-encapsulado && npm run check:files-encapsulado && npm run check:no-gated-files && npm run check:backup-encapsulado && npm run check:content && npm run test:ci-gates && npm run build:standalone && npm run check:lighthouse",
    "test:staging-auth": "node scripts/ci/test-staging-auth.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1130.0",
    "@aws-sdk/s3-presigned-post": "3.1130.0",
    "@aws-sdk/s3-request-presigner": "3.1130.0",
    "better-auth": "1.7.3",
    "drizzle-orm": "0.45.2",
    "gray-matter": "4.0.3",
    "motion": "13.2.0",
    "next": "16.3.4",
    "nodemailer": "10.0.3",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/nodemailer": "7.0.12",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "chrome-launcher": "1.2.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "lighthouse": "13.4.1",
    "smtp-server": "3.19.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "description": "Website pública, HQ y portal de clientes de SLG Agency"
}
