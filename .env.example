# =============================================================================
# slg_website — plantilla de variables de entorno
# -----------------------------------------------------------------------------
# SOLO NOMBRES. NUNCA VALORES. Este repositorio es PÚBLICO (START_PROJECT.md §10-6).
#
# Local:     copia este archivo a `.env`, que está ignorado por git.
# Producción: los valores viven en las variables de entorno de Easypanel, nunca
#             en un archivo del repositorio.
#
# Cada bloque indica QUÉ SERVICIO la consume y en QUÉ UNIDAD entra en juego.
# =============================================================================


# ─── Base de datos · slg-db · FU-04 ──────────────────────────────────────────
# Credenciales del contenedor PostgreSQL (solo desarrollo local).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Conexión de la APLICACIÓN. Usa el rol `slg_app`, que NO es dueño del esquema y
# NO tiene BYPASSRLS. Eso es lo que hace que las políticas de fila se apliquen de
# verdad: conectar aquí con el usuario dueño DESACTIVA todo el aislamiento entre
# empresas. La prueba `test:isolation` falla si alguien lo hace.
DATABASE_URL=

# Conexión para MIGRACIONES únicamente, con el usuario dueño. Nunca sirve
# peticiones. En Easypanel va en el paso de despliegue, no en el runtime.
DATABASE_URL_MIGRATIONS=


# ─── Aplicación · slg-web · FU-05 ────────────────────────────────────────────
# URL pública canónica. En staging apunta al subdominio de staging.
NEXT_PUBLIC_SITE_URL=

# Protege staging de indexación y de miradas ajenas (FU-05, criterio 1).
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASSWORD=


# ─── Identidad · Better Auth · FU-06 ─────────────────────────────────────────
# Secreto de firma de sesión. Distinto en staging y en producción.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Google — pantalla de consentimiento OAuth (Anexo F.2-2).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID (Anexo F.2-3). D-23: el correo se queda en Microsoft 365,
# así que el registro puede reutilizar el tenant existente.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=


# ─── Correo transaccional · Resend por SMTP · D-22, D-24, D-36 · FU-08 ───────
# Variables de TRANSPORTE, no de marca (`api_contracts` §11.3): D-36 exige que
# no exista variable de SDK propietario. Con Resend, MAIL_SMTP_HOST es su
# servidor SMTP y MAIL_SMTP_PASSWORD es su clave de API — NUNCA
# `RESEND_API_KEY`. Cambiar de proveedor cuesta estas variables y ninguna
# línea de código.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=

# D-24: subdominio de envío DEDICADO. El SPF de la raíz NO se toca, y los MX de
# Outlook tampoco. Sub-decisiones P-3 y P-4: valor PROVISIONAL del agente
# (D-54, `docs/decision_log.md`) mientras Ricardo no las confirme — no entra
# en el repositorio, solo en el `.env` local.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
MAIL_REPLY_TO=
# Destinatario de los avisos de captura y de fallo (RF-53, RF-50).
MAIL_ALERTS_TO=


# ─── Archivos de la aplicación · slg-files (MinIO) · D-51 · FU-09 ────────────
# API S3 GENÉRICA (`api_contracts` §11.4): cambiar de proveedor es endpoint +
# credenciales, igual que el destino de backups (D-21). D-51: hoy usa la
# credencial de administrador de MinIO — rotar a una clave acotada a estos dos
# buckets antes del go-live (R-41).
FILES_S3_ENDPOINT=
FILES_S3_REGION=
FILES_S3_ACCESS_KEY_ID=
FILES_S3_SECRET_ACCESS_KEY=
FILES_BUCKET_DOWNLOADS=
FILES_BUCKET_DELIVERABLES=

# Caducidad de las URLs firmadas — cierra RNF-20 (`api_contracts` §11.9, D-28):
# 15 min descarga pública, 10 min entregable del portal, 30 min subida por API.
SIGNED_URL_TTL_DOWNLOAD_MINUTES=
SIGNED_URL_TTL_DELIVERABLE_MINUTES=
SIGNED_URL_TTL_UPLOAD_MINUTES=


# ─── Anti-abuso propio · D-16 · FU-11 ────────────────────────────────────────
# `lib/anti-abuse/rate-limit.ts` recibe el umbral y la ventana como argumentos
# de cada llamada, no los lee de aquí directamente — quien construya el primer
# formulario real (DU-08) decide su propio umbral y lo pasa leyendo estas dos
# variables. Sin dominios de correo gratuito aquí: esa lista vive en la tabla
# `blocked_email_domain` (editable sin desplegar, RF-32), no en `.env`.
PUBLIC_FORM_RATE_LIMIT_MAX=
PUBLIC_FORM_RATE_LIMIT_WINDOW_MS=


# ─── Backups · Cloudflare R2 · D-21 · FU-14 ──────────────────────────────────
# R-37: R2 no ofrece Object Lock por API estándar. La credencial del proceso de
# copia debe ser de SOLO ESCRITURA; el borrado de copias antiguas usa otra
# distinta. Si ambas fueran la misma, quien comprometa el VPS podría borrar los
# backups además de los datos.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID_WRITE=
R2_SECRET_ACCESS_KEY_WRITE=
R2_ACCESS_KEY_ID_PRUNE=
R2_SECRET_ACCESS_KEY_PRUNE=


# ─── CRM Softlanding Global · D-19 · FU-11, DU-09 ────────────────────────────
CRM_API_BASE_URL=

# Dos claves, NUNCA una: alcance mínimo por integración (Anexo G, RNF-40).
CRM_API_KEY_CAPTURE=
CRM_API_KEY_READ=

# D-19: adaptador de dos modos. `contact_note` es lo único que el CRM permite
# hoy por clave de API; `lead_admission` requiere el endpoint POST /leads, que
# todavía no existe en el CRM.
CRM_MODE=

# Plantilla de enlace profundo a la ficha de contacto. Configurable a propósito:
# la ruta real del frontend del CRM está pendiente de confirmar.
CRM_CONTACT_URL_TEMPLATE=


# ─── Visor de entregables · D-45 · DU-19 ─────────────────────────────────────
# ORIGEN SEPARADO, normativo. Un HTML generado por un agente no puede leer la
# sesión del cliente porque el navegador lo aísla por política de origen.
# El `iframe sandbox` y la CSP estricta se mantienen como defensa en profundidad.
DELIVERABLE_VIEWER_ORIGIN=


# ─── Webhooks salientes · B.7 · DU-13 ────────────────────────────────────────
WEBHOOK_SIGNING_SECRET=
# n8n es suscriptor OPCIONAL. Nunca requisito de la v1.
N8N_WEBHOOK_URL=


# ─── Analítica · slg-analytics (Umami) · DU-14 ───────────────────────────────
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=


# ─── Monitorización externa · UptimeRobot · D-49 · FU-05 ─────────────────────
# La configuración vive EN UPTIMEROBOT, fuera del VPS: un monitor dentro de la
# máquina que vigila muere con ella. Aquí solo el webhook opcional para que n8n
# reciba la señal como monitor SECUNDARIO.
UPTIME_WEBHOOK_SECRET=
