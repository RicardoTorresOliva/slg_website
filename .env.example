# =============================================================================
# slg_website — plantilla de variables de entorno
# -----------------------------------------------------------------------------
# SOLO NOMBRES. NUNCA VALORES. Este repositorio es PÚBLICO (START_PROJECT.md §10-6).
#
# Local:     copia este archivo a `.env`, que está ignorado por git.
# Producción: los valores viven en las variables de entorno de Easypanel, nunca
#             en un archivo del repositorio.
#
# Cada bloque indica QUÉ SERVICIO la consume y en QUÉ UNIDAD entra en juego.
# =============================================================================


# ─── Base de datos · slg-db · FU-04 ──────────────────────────────────────────
# Credenciales del contenedor PostgreSQL (solo desarrollo local).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Conexión de la APLICACIÓN. Usa el rol `slg_app`, que NO es dueño del esquema y
# NO tiene BYPASSRLS. Eso es lo que hace que las políticas de fila se apliquen de
# verdad: conectar aquí con el usuario dueño DESACTIVA todo el aislamiento entre
# empresas. La prueba `test:isolation` falla si alguien lo hace.
# Con Supabase, por el pooler en MODO TRANSACCIÓN (puerto 6543), no en modo sesión
# (5432): el de sesión limita a 15 clientes en total y dos instancias lo agotan.
DATABASE_URL=

# Conexión para MIGRACIONES únicamente, con el usuario dueño. Nunca sirve
# peticiones. En Easypanel va en el paso de despliegue, no en el runtime.
DATABASE_URL_MIGRATIONS=


# ─── Aplicación · slg-web · FU-05 ────────────────────────────────────────────
# URL pública canónica. En staging apunta al subdominio de staging.
# OBLIGATORIA Y SIN VALOR POR DEFECTO: de ella salen el `canonical`, las etiquetas
# sociales, el sitemap, el robots y los enlaces del RSS. Sin ella, `next build`
# se detiene diciendo su nombre — antes hacía lo contrario, inventarse un dominio.
NEXT_PUBLIC_SITE_URL=

# Protege staging de indexación y de miradas ajenas (FU-05, criterio 1).
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASSWORD=

# SUPERFICIES ABIERTAS PARA LA REVISIÓN VISUAL. Valores: `hq`, `portal`, o las
# dos separadas por coma. VACÍA en producción; VACÍA también en local salvo que
# estés revisando.
#
# QUÉ DESHACE. Cinco unidades de M3 y M4 tenían todo verificado menos la
# revisión visual, y la revisión visual esperaba a que la superficie se abriera.
# La superficie se abre al cerrar el milestone. El milestone no cierra hasta que
# cierren sus unidades. Nadie podía ver una sola pantalla de las intranets.
#
# SOLO FUNCIONA DONDE HAY COMPUERTA DE STAGING DELANTE, es decir donde
# STAGING_BASIC_AUTH_USER y STAGING_BASIC_AUTH_PASSWORD están puestas. Copiada a
# producción NO HACE NADA, y eso está probado con sesión válida en `test:acceso`:
# copiar el bloque de variables de un entorno a otro es el accidente que de
# verdad ocurre, y su fallo sería silencioso.
#
# No sustituye a nada: dentro siguen haciendo falta sesión válida y el rol de la
# matriz B.3. Lo único que retira es el 404 de «tu milestone sigue abierto».
# Cuando M3 y M4 cierren, se pone `true` en `lib/auth/roles.ts` y esta variable
# se retira.
SUPERFICIES_EN_REVISION=


# ─── Identidad · Better Auth · FU-06 ─────────────────────────────────────────
# Secreto de firma de sesión. Distinto en staging y en producción.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Google — pantalla de consentimiento OAuth (Anexo F.2-2).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID (Anexo F.2-3). D-23: el correo se queda en Microsoft 365,
# así que el registro puede reutilizar el tenant existente.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=


# ─── Correo transaccional · D-22, D-24, D-36 · FU-08 ─────────────────────────
# VARIABLES DE TRANSPORTE, NO DE MARCA. El adaptador habla SMTP estándar y no el
# SDK del proveedor (D-22, D-36): el proveedor elegido se configura poniendo su
# servidor aquí y su clave de API como MAIL_SMTP_PASSWORD. Por eso NO existe una
# variable con el nombre del producto, y esa ausencia ES la decisión: cambiar de
# proveedor cuesta cuatro variables y ninguna línea de código.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=

# D-24: el remitente vive en el SUBDOMINIO DE ENVÍO DEDICADO, no en la raíz. El
# SPF de la raíz no se toca y los MX de Outlook tampoco: son entradas DNS
# distintas, así que publicar las del subdominio no puede romper el correo
# humano (R-38). Se persiste en email_delivery.from_email en cada envío.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# Dirección de respuesta. El brief §5.1 y RF-117 dicen que el remitente es
# support@softlandingglobal.com y quedan DESACTUALIZADOS desde D-24: support@ es
# el Reply-To y el destinatario de los avisos, no el From.
MAIL_REPLY_TO=

# Destinatario de los avisos de captura entregada y de fallo tras el quinto
# intento (RF-53, RF-50).
MAIL_ALERTS_TO=

# Buzón del CLIENTE que recibe los contactos de la web: en el intake, «Correo que
# debe recibir los mensajes del formulario de contacto de la web». Solo se usa,
# y entonces es OBLIGATORIA, en un sitio sin CRM (`modulos.crm: false` en
# site.config.ts): cada captura se le avisa por correo con los datos del
# contacto, y ese correo es el único aviso. Consumidor: lib/crm/sin-crm.ts. No
# es MAIL_ALERTS_TO, que es el buzón del equipo que opera el sitio.
MAIL_LEADS_TO=


# ─── Archivos de la aplicación · slg-files (MinIO) · FU-09 ───────────────────
# API S3 GENÉRICA, no el SDK del producto: cambiar de destino es endpoint y
# credenciales. Los DOS buckets son PRIVADOS y ninguna ruta lista su contenido
# (RF-123, gate D10).
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_DOWNLOADS=
S3_BUCKET_DELIVERABLES=

# Caducidad de las URL firmadas, en minutos (RNF-20, D-28, api_contracts §11.9).
# Son VARIABLES y no constantes porque el criterio 3 de FU-09 exige que el valor
# se lea de configuración. Vacías = los defectos de lib/db/limits.ts (15/10/30).
# Toda URL de archivo caduca, sin excepción: no hay forma de pedir una permanente.
SIGNED_URL_TTL_DOWNLOAD_MINUTES=
SIGNED_URL_TTL_DELIVERABLE_MINUTES=
SIGNED_URL_TTL_UPLOAD_MINUTES=


# ─── Backups ─────────────────────────────────────────────────────────────────
# Aquí había siete variables `R2_*` declaradas en FU-05, cuando la unidad de
# copias todavía no existía. FU-14 la construyó y las llamó `BACKUP_*`, así que
# durante un tiempo hubo **dos juegos de variables para el mismo trabajo** — que
# es exactamente cómo alguien rellena el que no se lee. Las `R2_*` se retiran:
# las de verdad están al final de este archivo, en su propio bloque.


# ─── Visor de entregables · D-45 · DU-19 ─────────────────────────────────────
# ORIGEN SEPARADO, normativo. Un HTML generado por un agente no puede leer la
# sesión del cliente porque el navegador lo aísla por política de origen.
# El `iframe sandbox` y la CSP estricta se mantienen como defensa en profundidad.
#
# EL SUBDOMINIO ES `https://visor.softlandingglobal.com` (DU-19 fija el
# [PENDIENTE] que D-45 dejó abierto). Se llama «visor» y no «entregables»
# porque nombra el MECANISMO: el día que por ahí se sirva algo que no es un
# entregable, un nombre que describe el contenido obligaría a migrar URLs.
#
# SIN ESTA VARIABLE, el visor NO sirve HTML — y tampoco lo sirve si se apunta al
# mismo dominio de la aplicación, que es el fallo silencioso. No hay repliegue
# «mientras tanto» al mismo origen: ese repliegue es justo lo que D-45 prohíbe.
DELIVERABLE_VIEWER_ORIGIN=

# EL VALE DEL VISOR. El visor vive en un origen SIN SESIÓN: el navegador no le
# manda las cookies de la aplicación, y esa es justo su razón de ser. Sin esta
# variable, la única credencial para leer un entregable era conocer su
# identificador — un secreto permanente, sin caducidad y sin forma de revocarlo,
# viajando en el `src` de un iframe hasta historiales y registros de proxy.
#
# Con ella, la pantalla del portal —que SÍ comprobó empresa, visibilidad y rol—
# firma un permiso con caducidad para ese entregable concreto, y el visor no
# autoriza: verifica. HMAC-SHA256, comparación en tiempo constante.
#
# FALLA CERRADO: sin secreto no hay vale válido y el visor no sirve nada. Es
# preferible un visor que no funciona a un visor que entrega documentos de
# cliente a quien conozca un identificador.
#
# Cadena larga al azar, distinta de cualquier otra. La caducidad la hereda de
# SIGNED_URL_TTL_DELIVERABLE_MINUTES.
DELIVERABLE_VIEWER_SECRET=


# ─── Webhooks salientes · B.7 · DU-12 ────────────────────────────────────────
# NINGUNA DE ESTAS ES REQUISITO (RF-115). Sin suscriptor configurado el sistema
# funciona igual y los eventos QUEDAN REGISTRADOS en `webhook_delivery`.
#
# Forma corta, un solo destino: la URL de n8n y su secreto.
WEBHOOK_SIGNING_SECRET=
# n8n es suscriptor OPCIONAL. Nunca requisito de la v1.
N8N_WEBHOOK_URL=
# Forma general, varios destinos, con SECRETO POR SUSCRIPTOR (RF-113):
# [{"nombre":"n8n","url":"https://…/webhook/slg","secreto":"…"}]
# Dos destinos no comparten clave nunca: revocar la de uno obligaría a rotar la
# del otro.
WEBHOOK_SUBSCRIBERS=
# Cadencia y paciencia del barrendero. Los valores por defecto (20 s, 10 filas,
# 10 s de espera) sirven sin tocar nada.
WEBHOOK_QUEUE_INTERVAL_MS=
WEBHOOK_QUEUE_BATCH=
WEBHOOK_TIMEOUT_MS=
# `post.published` de los artículos ya desplegados, en cada arranque (RF-145).
# APAGADO por defecto A PROPÓSITO: encenderlo por primera vez sobre una base sin
# registros anunciaría el histórico entero de golpe. Se pone a "1" desde el
# primer despliegue que tenga suscriptor, y desde entonces cada despliegue
# anuncia solo lo publicado desde el anterior.
WEBHOOK_ANNOUNCE_POSTS=


# ─── Analítica autoalojada · slg-analytics (Umami) · DU-12 ───────────────────
# AUTOALOJADA O NADA (RF-127, RF-35). Sin estas dos variables la capa pública no
# carga NINGÚN script y no pone NINGUNA cookie: ese es el estado por defecto.
# El origen de la URL se añade solo a `script-src` y `connect-src` en
# `middleware.ts`, leyendo esta misma variable.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=


# ─── Monitorización externa · UptimeRobot · D-49 · FU-05 ─────────────────────
# La configuración vive EN UPTIMEROBOT, fuera del VPS: un monitor dentro de la
# máquina que vigila muere con ella. Aquí solo el webhook opcional para que n8n
# reciba la señal como monitor SECUNDARIO.
UPTIME_WEBHOOK_SECRET=


# ─── Puesta en marcha de la base de datos · /api/ops · DU-00 ─────────────────
# La contraseña del rol `slg_app`. La migración 0002 crea el rol SIN contraseña
# a propósito —este repositorio es público— y el botón «Ponerle la contraseña al
# usuario de la base» de /api/ops se la pone leyendo esta variable.
#
# TIENE QUE SER LA MISMA que va dentro de DATABASE_URL. Si no coinciden, el sitio
# deja de conectar en cuanto se pulsa el botón.
#
# Nunca llega por la petición: se lee del entorno. Una ruta que aceptara la
# contraseña por parámetro sería una ruta para cambiar la clave de la base desde
# fuera.
APP_DB_PASSWORD=


# ─── Comprobación de infraestructura · /api/ops · temporal ───────────────────
# SE PONEN PARA COMPROBAR Y SE BORRAN DESPUÉS. Mientras `OPS_TOKEN` esté vacía,
# la ruta `/api/ops` NO EXISTE: devuelve 404, igual que cualquier ruta
# inventada. Con ella puesta, abrir
# `https://<dominio>/api/ops?token=<OPS_TOKEN>` comprueba, contra la
# infraestructura real y desde el navegador: que el dominio del remitente tiene
# DKIM y SPF publicados, que sale un correo de prueba a cada dirección de
# `OPS_MAIL_TO`, y que el bucket `downloads` acepta una subida firmada y
# RECHAZA una lectura sin firmar —que es la prueba de que es privado—.
# El testigo tiene que ser largo y aleatorio: es la única puerta de esa ruta.
OPS_TOKEN=
# Tres direcciones de PROVEEDORES DISTINTOS, separadas por comas. Salen de aquí
# y nunca de la petición: ni con el testigo filtrado sirve para mandar correo a
# terceros.
OPS_MAIL_TO=
# Testigo de `/api/colas`, la ruta que barre las colas (CRM, webhooks) a petición
# de un planificador externo: cron de la plataforma, temporizador del sistema o
# monitor con cabecera `Authorization: Bearer <testigo>`. OPCIONAL: sin él la
# ruta responde 404 y las colas se vacían igual tras cada captura y con cada
# visita de la sonda `/api/health` (ver `lib/colas/barrer.ts`). Largo y aleatorio.
CRON_SECRET=


# ─── Anti-abuso propio · FU-11 · D-16 ────────────────────────────────────────
# CERO desafíos de terceros: la protección es nuestra (RF-35, frontera (h)).
# El umbral NO se revela en la respuesta (RF-34): quien lo sabe pide justo eso.
PUBLIC_FORM_RATE_LIMIT_MAX=
PUBLIC_FORM_RATE_LIMIT_WINDOW_MS=
# La lista de dominios de correo gratuito NO es una variable: vive en la tabla
# `free_email_domain` (D-82). Ampliarla es un INSERT, sin desplegar (RF-32).


# ─── Consentimiento · DU-08 ──────────────────────────────────────────────────
# La versión de la política que el visitante aceptó se guarda CON la captura
# (RF-36): el consentimiento es a un texto concreto, y si mañana cambia hay que
# poder demostrar cuál era el de ayer.
PRIVACY_POLICY_VERSION=


# ─── CRM Softlanding Global · DU-09, DU-13 · D-19 ────────────────────────────
# El CRM es el SISTEMA DE REGISTRO de leads: aquí se entrega y se LEEN métricas,
# nunca se gestiona el pipeline ni se abren oportunidades (RF-57, RF-85).
CRM_BASE_URL=
# DOS CLAVES DE SERVICIO, NUNCA UNA (RF-56, RNF-40). Alcance mínimo POR
# integración: si el tablero usara la de captura, una pantalla de lectura
# llevaría permiso de escritura, y revocarla apagaría además la captura de leads.
# Ninguna es un login de persona.
#   «Website — captura»  → contacts:write, activities:write, crm:read
CRM_API_KEY_CAPTURE=
#   «Website — tablero»  → crm:read
CRM_API_KEY_READ=
# `contact_note` (el que el CRM expone hoy) o `lead_admission` (el endpoint de
# admisión, todavía no publicado). Cambiar de modo NO exige migrar datos ni
# tocar código (R-24, RF-46).
CRM_MODE=
CRM_TIMEOUT_MS=
# Plantilla del enlace profundo a la ficha, con `{id}` donde va el contacto
# (RF-54). Se acepta `{contact_id}` como sinónimo, porque el documento de
# contrato lo escribía así y una plantilla copiada de allí habría producido un
# enlace roto en un correo sin que nada fallara. Configurable a propósito: un CRM
# que cambie de rutas no debe obligar a desplegar.
CRM_CONTACT_URL_TEMPLATE=
# El barrido tiene que ser MENOR que el escalón de espera más corto (1 min), o
# la espera real no sería la de RF-50 y el gate D7 mediría otra cosa.
CRM_QUEUE_INTERVAL_MS=
CRM_QUEUE_BATCH=
# `1` apaga el barrendero dentro del proceso: lo usan las pruebas y el barrido
# manual. En producción se deja vacío.
CRM_QUEUE_DISABLED=
# La caché de las métricas del tablero, en segundos. El defecto son los 300 s
# que fija RF-55: el tablero no puede convertirse en tráfico contra el CRM.
CRM_METRICS_CACHE_SECONDS=
# A dónde lleva el botón «Abrir CRM» del tablero (RF-75).
CRM_APP_URL=

# ── Copias de seguridad (FU-14 · D-20 · D-21 · R-12 · R-37) ────────────────────
#
# EL DESTINO ES «OBJECT STORAGE S3-COMPATIBLE EXTERNO», NO UN PROVEEDOR. Hoy es
# Cloudflare R2 (D-21); cambiar de proveedor son estas cuatro variables y
# ninguna línea de código. Tiene que estar **fuera del proveedor que aloja el
# VPS**: una copia en la misma casa que el original no es una copia.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
# Credencial del proceso que COPIA. **De solo escritura, SIN permiso de
# borrado.** No es una precaución de más: R2 no ofrece Object Lock por API
# estándar (R-37), así que lo que protege el histórico de un borrado malicioso es
# que la credencial que vive en el servidor no pueda borrar.
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Credencial del proceso que PURGA. Otra, y con permiso de borrado. Vive donde
# corre la purga, que NO es el servidor de la aplicación.
BACKUP_PURGE_ACCESS_KEY_ID=
BACKUP_PURGE_SECRET_ACCESS_KEY=
# Clave PÚBLICA de cifrado (PEM, X25519). **No es un secreto**: solo cifra. Es lo
# único que vive en el servidor, y por eso quien entre en él no puede leer las
# copias (criterio 3, R-12).
BACKUP_PUBLIC_KEY=
# Clave PRIVADA. **NO se pone en el servidor ni en el repositorio.** Se define
# solo en la sesión donde se restaura, y se quita al terminar.
BACKUP_PRIVATE_KEY=
# Rutas de los volúmenes de archivos que hay que copiar, separadas por comas.
# Sin esto solo se copia la base, y un sistema que arranca con los entregables
# rotos parece que funciona.
BACKUP_VOLUME_PATHS=
# Retenciones por generación. Nunca bajan del defecto (14 / 8 / 12): una
# variable mal escrita no puede acortar la retención en silencio.
BACKUP_RETENTION_DAILY=
BACKUP_RETENTION_WEEKLY=
BACKUP_RETENTION_MONTHLY=
# A quién se avisa si la copia falla (R-27). Sin esto, el único aviso es el
# código de salida del cron.
BACKUP_ALERT_EMAIL=
# LA FECHA DE LA PRIMERA COPIA, en YYYY-MM-DD. Va en la TAREA DE PURGA, no en
# `slg-web`.
#
# R2 NO OFRECE UN TOKEN QUE ESCRIBA Y NO BORRE: su permiso de objeto más acotado
# —Object Read & Write— incluye DeleteObject. La mitigación de R-37 estaba
# escrita como si esa prevención existiera, y no existe. Lo que sí puede existir
# es darse cuenta: antes de purgar, el proceso comprueba que las copias que
# deberían seguir ahí siguen ahí, y avisa si falta alguna.
#
# Esta variable es lo que evita la alarma falsa: antes de esa fecha no hay nada
# que echar en falta. SIN ELLA EL CENTINELA NO CORRE, y lo dice por la salida en
# vez de callarse.
BACKUP_FIRST_DATE=
# Fecha forzada, SOLO para el simulacro de restauración. Producción no la define.
BACKUP_DATE_OVERRIDE=
# Binarios, si no están en el PATH con su nombre.
PG_DUMP_BIN=
PG_RESTORE_BIN=

# ── Proveedor de archivos ────────────────────────────────────────────────────
# Vacío: S3/MinIO (el VPS, diseño de architecture §7.1). «supabase»: Supabase
# Storage por su REST, con la clave de servicio; entonces las S3_* de arriba
# no hacen falta. Los nombres de bucket (S3_BUCKET_*) valen para los dos.
FILES_DRIVER=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
